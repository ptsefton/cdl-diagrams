@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include_many ../data-lab-style.txt
!include c4-style.txt

HIDE_STEREOTYPE()

LAYOUT_TOP_DOWN()

Boundary(infra, "Infrastructure", "", $tags="infra-main") {
   System_Boundary(admin, "Administrative Systems", "", $tags="infra-admin") {
      Boundary(cris, "Current Research Information Systems (CRIS)", "", $tags="infra-admin") {
         Container(grants, "Grants & Financial", "", $tags="infra-admin")
         Container(ethics, "Ethics", "", $tags="infra-admin")
         Container(metrics, "Research Metrics", "", $tags="infra-admin")
      }
      Container(dmp, "Data Management Planning", "", $tags="infra-admin")
      Container(rights, "Licence and Rights\nManagement", "", $tags="infra-admin")
      Container(auth, "Authentication & Authorization", "", $tags="infra-admin")
   }

   System_Boundary(repo, "Archival Repositories", "", $tags="infra-repository") {
      Container(ja, "Journals, books & other publications", "", $tags="infra-repository")
      Container(glam, "GLAM systems", "", $tags="infra-repository")
      Container(irs, "Institutional Research\nRepositories", "", $tags="infra-repository")
      Container(domain_repo, "Domain Repositories", "", $tags="infra-repository")
      Container(pub, "Public Repositories", "", $tags="infra-repository")
      Container(lib, "Libraries", "", $tags="infra-repository")
   }

   System_Boundary(ws, "Workspaces", "", $tags="infra-workspace") {
      Container(new_data, "Novel /\nnon-archive\ndata", "", $tags="infra-workspace")
      ContainerDb(risk, "At-risk needs-to-be-archived\ndata in working storage", "", $tags="infra-workspace")
      Container(comp, "Computing Environments", "", $tags="infra-workspace")
      Container(survey, "Survey tools", "", $tags="infra-workspace")
      Container(eln, "Electronic Lab Notebooks", "", $tags="infra-workspace")
      Container(other, "Other research tools", "", $tags="infra-workspace")
   }
}

@enduml
